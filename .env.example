# ============================================================
# Meccanen Hava Durumu — ortam değişkenleri
# ============================================================
# Bu dosyayı kopyalayıp `.env` olarak kaydet ve değerleri doldur:
#     cp .env.example .env
#
# NOT 1: `.env` yalnızca geliştirmede (npm run dev) ve yerel web
#        build'lerinde kullanılır. CI build'leri (GitHub Actions) bu
#        değerleri repo Settings → Secrets and variables → Actions
#        altındaki secret'lardan alır (bkz. .github/workflows/build-apk.yml).
# NOT 2: Vite `VITE_` ön ekiyle başlayan değişkenleri tarayıcı koduna
#        gömebilir. Bu yüzden BURAYA yazılan değerler uygulama paketine
#        girer — yalnızca istemcide zaten olması gereken değerleri koy.
#        (Sunucu tarafına saklaman gereken değerler VITE_ olmamalı ve
#        buraya hiç yazılmamalı.)

# WeatherAPI.com API anahtarı (ZORUNLU) — hava durumu verisi kaynağı.
# https://www.weatherapi.com — hesabından "API Key" bölümünden al.
# ÖNEMLİ: Uygulama bu anahtarı doğrudan tarayıcıdan çağırır (public key).
#         Free katman limitleri için bkz. src/services/weatherService.ts.
VITE_WEATHER_API_KEY=

# AdMob banner reklam birimi ID'si (ZORUNLU, reklam göstereceksek).
# https://apps.admob.com → Uygulamalar → Reklam birimleri → Banner
# Biçim: ca-app-pub-XXXXXXXXXXXXXXXX/YYYYYYYYYY
VITE_ADMOB_BANNER_ID=

# AdMob ödüllü geçiş reklamı (Rewarded Interstitial) birim ID'si (ZORUNLU).
# Detay ekranları (UV / Hava Kalitesi / Ay Evresi / Uyarı / Gün) için.
VITE_ADMOB_REWARDED_INTERSTITIAL_ID=

# (OPSİYONEL) Test cihaz ID'leri — virgülle ayrılmış.
# AdMob'a "test cihazı" olarak kaydedilmiş cihazlar GERÇEK değil, test
# reklamı alır (tıklama/beklenmedik trafik riskine sokmaz). ID'yi öğrenmek
# için: uygulamayı logcat açıkken çalıştırıp "Use RequestConfiguration..."
# satırındaki ID'yi kopyala. Boş bırakılırsa normal üretim modunda çalışır.
# CI'da ADMOB_TEST_DEVICE_IDS secret'ı ile beslenir.
VITE_ADMOB_TEST_DEVICE_IDS=

# (OPSİYONEL, yalnızca geliştirme/test) "true" ise ödüllü geçiş reklamı
# HİÇ çağrılmaz; butona basınca 2 sn beklenip kilit sanki izlenmiş gibi
# açılır. Closed Test aşamasında CI bu değeri "true" gönderiyor.
# PRODUCTION'A GEÇERKEN CI workflow'undaki satırı kaldır/kapat.
# Boş bırakılırsa gerçek reklam akışı çalışır.
VITE_DEBUG_SKIP_REWARDED_AD=false